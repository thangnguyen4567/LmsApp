{
  "name": "LMS",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --appId com.vnresourceelmspro",
    "ios": "react-native run-ios --simulator='iPhone 15 Plus'",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "create-bundle": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "resetcache": "npx react-native start --reset-cache",
    "clear-al": "npx react-native-clean-project",
    "clean:android": "cd android && .\\gradlew.bat --stop && .\\gradlew.bat clean",
    "android:release": "react-native run-android --mode release --appId com.vnresourceelmspro",
    "android:apk": "cd android && .\\gradlew.bat assembleRelease",
    "android:aab": "cd android && .\\gradlew bundleRelease"
  },
  "dependencies": {
    "@preeternal/react-native-cookie-manager": "^6.3.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "i18next": "^26.0.4",
    "react": "19.2.3",
    "react-i18next": "^17.0.2",
    "react-native": "0.84.1",
    "react-native-blob-util": "^0.24.10",
    "react-native-localize": "^3.7.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-onesignal": "^5.2.0",
    "react-native-permissions": "^5.2.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.5.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "^13.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
